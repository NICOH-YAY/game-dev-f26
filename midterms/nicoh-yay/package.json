    "build": "tsc -p tsconfig.build.json",
    "balance": "npm run build --silent && node experiments/balance.mjs"
  },
  "dependencies": {
    "@google/genai": "^1.46.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.5"
  }
}
